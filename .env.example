# MongoDB Atlas connection string. Example: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/thinkstack
MONGODB_URI=

# Lesson generation tries these in order and skips any key that is blank.
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional. Defaults to openai/gpt-4o-mini.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Backboard: https://app.backboard.io Settings → API Keys
BACKBOARD_API_KEY=
# Optional. Defaults to openai and gpt-4.1, then Claude Sonnet 4.6 and gpt-4o-mini.
BACKBOARD_PROVIDER=openai
BACKBOARD_MODEL=gpt-4.1

# Gemini: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional. Defaults to gemini-3.8-flash.
# If that model is overloaded, generation also tries gemini-3.5-flash,
# gemini-3.5-flash-lite, and gemini-flash-latest.
GEMINI_MODEL=gemini-3.8-flash

# Signs the login cookie. Use a long random string in production.
SESSION_SECRET=

# Google sign-in. Authorized redirect URI: http://localhost:3000/api/auth/google/callback
# and the same path on your Vercel domain.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
