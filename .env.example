# Leave these blank until you have accounts. The app still runs:
# lessons are stored in .data/store.json, and known topics use a built-in planner.

# MongoDB Atlas connection string. Example: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/thinkstack
MONGODB_URI=

# API key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Defaults to gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash
